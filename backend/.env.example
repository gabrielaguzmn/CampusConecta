# Copia este archivo a .env, rellena los valores y cárgalo antes de usar manage.py:
#   set -a; source .env; set +a
# (usa valores sin espacios ni caracteres especiales del shell, o ponlos entre comillas simples)

# Django
DJANGO_SECRET_KEY=prueba
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (con HOST vacío se usa el socket local).
# Para la base compartida en Render, usa los datos que te pase quien la administra, DB_PORT=5432 y DB_SSLMODE=require.
DB_NAME=campusconecta
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=

# Orígenes del frontend separados por comas (CORS), p. ej. http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Página del frontend para restablecer la contraseña; el enlace del correo le añade ?uid=...&token=... (G-17)
FRONTEND_URL_RECUPERACION=http://localhost:5173/recuperar/confirmar

# Deepgram: clave maestra solo en el backend; el navegador recibe tokens efímeros.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-celeste-es

# Imágenes de eventos (en producción, un volumen persistente) — G-42
MEDIA_ROOT=

# Correo: con DEBUG=1 se imprime en consola; para entrega real usa SMTP explícito.
# Proveedor SMTP, por ejemplo Brevo, SendGrid, Mailgun o Gmail con contraseña de aplicación.
DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
