# Copia este archivo a .env, rellena los valores y cárgalo antes de usar manage.py:
#   set -a; source .env; set +a
# (usa valores sin espacios ni caracteres especiales del shell, o ponlos entre comillas simples)

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (con HOST vacío se usa el socket local).
# Para la base compartida en Supabase (Session pooler), usa los datos que te pase quien la administra y DB_SSLMODE=require.
DB_NAME=campusconectadb
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=

# Orígenes del frontend separados por comas (CORS), p. ej. http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Página del frontend para restablecer la contraseña; el enlace del correo le añade ?uid=...&token=... (G-17)
FRONTEND_URL_RECUPERACION=http://localhost:5173/recuperar/confirmar

# Imágenes de eventos (en producción, un volumen persistente) — G-42
MEDIA_ROOT=

# Correo (solo se usa SMTP con DJANGO_DEBUG distinto de 1)
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Cuenta administradora inicial (RF-029): comando crear_admin_inicial
ADMIN_INICIAL_NOMBRE=
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
